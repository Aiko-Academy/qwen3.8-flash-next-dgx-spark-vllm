docker
run
-d
--name
vllm-flashnext
--restart
unless-stopped
--gpus
all
--ipc
host
--shm-size
32g
--ulimit
memlock=-1:-1
--ulimit
stack=67108864
-e
CUTE_DSL_ARCH=sm_121a
-e
FLASHINFER_DISABLE_VERSION_CHECK=1
-e
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
-e
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
-e
HF_HUB_OFFLINE=1
-e
TRANSFORMERS_OFFLINE=1
-e
VLLM_ENGINE_READY_TIMEOUT_S=3600
--cpuset-cpus
5-9,15-19
-e
VLLM_USE_DEEP_GEMM=0
-e
VLLM_FP8_HYBRID=1
-e
VLLM_MTP_DRAFT_NVFP4=1
-e
VLLM_QSA_DET_TOPK=1
-e
VLLM_QSA_DET_LIB=/opt/kernel-det/_C_det.so
-e
VLLM_MTP_DRAFT_VOCAB=/opt/draft-vocab/draft_vocab_public_65536.npy
-v
<repo>/patches/fp8-hybrid/vllm_fp8_hybrid_modelopt.py:/usr/local/lib/python3.12/dist-packages/vllm_fp8_hybrid_modelopt.py:ro
-v
<repo>/patches/fp8-hybrid/vllm-overlay/model_executor/layers/quantization/modelopt.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/modelopt.py:ro
-v
<repo>/patches/fp8-hybrid/vllm-overlay/models/qwen4_exp/nvidia/qsa.py:/usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/qsa.py:ro
-v
<repo>/patches/cache-det/vllm-overlay/v1/core/sched/scheduler.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/sched/scheduler.py:ro
-v
<repo>/patches/cache-det/vllm-overlay/models/qwen4_exp/nvidia/ops/qsa_indexer.py:/usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/ops/qsa_indexer.py:ro
-v
<repo>/build/_C_det.so:/opt/kernel-det/_C_det.so:ro
-v
<repo>/patches/draft-nvfp4-head/vllm-overlay/models/qwen4_exp/nvidia/mtp.py:/usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/mtp.py:ro
-v
<repo>/build/draft_vocab_public_65536.npy:/opt/draft-vocab/draft_vocab_public_65536.npy:ro
-v
<repo>/patches/tool-parser/vllm-overlay/entrypoints/openai/responses/protocol.py:/usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/protocol.py:ro
-v
<repo>/patches/tool-parser/vllm-overlay/entrypoints/openai/responses/serving.py:/usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/serving.py:ro
-v
<repo>/patches/tool-parser/vllm-overlay/parser/abstract_parser.py:/usr/local/lib/python3.12/dist-packages/vllm/parser/abstract_parser.py:ro
-v
<repo>/patches/tool-parser/vllm-overlay/parser/engine/adapters.py:/usr/local/lib/python3.12/dist-packages/vllm/parser/engine/adapters.py:ro
-v
<repo>/patches/tool-parser/vllm-overlay/parser/engine/parser_engine.py:/usr/local/lib/python3.12/dist-packages/vllm/parser/engine/parser_engine.py:ro
-v
<repo>/patches/tool-parser/vllm-overlay/parser/engine/parser_engine_config.py:/usr/local/lib/python3.12/dist-packages/vllm/parser/engine/parser_engine_config.py:ro
-v
<repo>/patches/tool-parser/vllm-overlay/parser/engine/streaming_parser_engine.py:/usr/local/lib/python3.12/dist-packages/vllm/parser/engine/streaming_parser_engine.py:ro
-v
<repo>/patches/tool-parser/vllm-overlay/parser/nemotron_v3.py:/usr/local/lib/python3.12/dist-packages/vllm/parser/nemotron_v3.py:ro
-v
<repo>/patches/tool-parser/vllm-overlay/parser/qwen3.py:/usr/local/lib/python3.12/dist-packages/vllm/parser/qwen3.py:ro
-v
/var/tmp/models/Qwen3.8-Flash-Next-NVFP4-nvidia-fp8hybrid:/models/flashnext:ro
-v
/var/tmp/qwen38fn-vllm-cache:/root/.cache
-v
<repo>/patches/ple-checkpoint-mapped/vllm-overlay/vllm/config/engram.py:/usr/local/lib/python3.12/dist-packages/vllm/config/engram.py:ro
-v
<repo>/patches/ple-checkpoint-mapped/vllm-overlay/vllm/models/qwen4_exp/common/ngram_embedding.py:/usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/common/ngram_embedding.py:ro
-v
<repo>/patches/ple-checkpoint-mapped/vllm-overlay/vllm/models/qwen4_exp/nvidia/model_state.py:/usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/model_state.py:ro
-v
<repo>/patches/ple-checkpoint-mapped/vllm-overlay/vllm/models/qwen4_exp/nvidia/ngram_embedding.py:/usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/ngram_embedding.py:ro
-v
<repo>/patches/ple-checkpoint-mapped/vllm-overlay/vllm/models/qwen4_exp/nvidia/ple_pageable.py:/usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/ple_pageable.py:ro
-v
<repo>/patches/mrope-draft-floor/vllm-overlay/model_executor/layers/rotary_embedding/mrope.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/rotary_embedding/mrope.py:ro
-v
<repo>/patches/auth-all-routes/vllm-overlay/entrypoints/serve/middleware/authenticate.py:/usr/local/lib/python3.12/dist-packages/vllm/entrypoints/serve/middleware/authenticate.py:ro
-p
127.0.0.1:8000:8000
--entrypoint
vllm
vllm/vllm-openai:v0.32.0
serve
/models/flashnext
--served-model-name
qwen3.8-flash-next
--trust-remote-code
--quantization
modelopt
--tensor-parallel-size
1
--max-model-len
524288
--gpu-memory-utilization
0.80
--kv-cache-dtype
fp8
--max-num-seqs
16
--max-num-batched-tokens
4096
--engram-config
{"checkpoint_mapped": true}
--reasoning-parser
qwen3
--enable-auto-tool-choice
--tool-call-parser
qwen3_xml
--default-chat-template-kwargs
{"enable_thinking": false}
--speculative-config
{"method":"mtp","num_speculative_tokens":2,"max_model_len":524288}
--no-enable-flashinfer-autotune
--host
0.0.0.0
--port
8000
--hf-overrides
{"text_config": {"rope_parameters": {"mrope_interleaved": true, "mrope_section": [11, 11, 10], "rope_type": "yarn", "rope_theta": 10000000, "partial_rotary_factor": 0.25, "factor": 2.0, "original_max_position_embeddings": 262144}}}
--kv-cache-dtype-skip-layers
48
--mamba-ssm-cache-dtype
bfloat16
