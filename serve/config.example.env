# Configuration of serve.sh, prepare.sh and verify.sh. Copy it, edit it, and pass it by name:
#   SERVE_CONFIG=~/flashnext.env serve/serve.sh
# Every value below is the default; a line left commented keeps it.

# Image, pinned by its registry digest (serve.sh refuses another one unless ALLOW_UNPINNED_IMAGE=1).
#IMAGE=vllm/vllm-openai:v0.32.0
#IMAGE_DIGEST=sha256:befccf0e7e4089aa23926bb6f887a85c0d46c2a99e6de5c5ffdf5cb7957c5b34
#CONTAINER=vllm-flashnext

# Network. Without API_KEY_FILE, serve.sh only binds 127.0.0.1.
#BIND=127.0.0.1
#PORT=8000
# A docker --env-file holding one line VLLM_API_KEY=<key>; readable by you only (chmod 600).
#API_KEY_FILE=

# Checkpoint as downloaded (prepare.sh download), then with its dense layers in block FP8 (prepare.sh convert).
#SOURCE_DIR=/var/tmp/models/Qwen3.8-Flash-Next-NVFP4-nvidia
#MODEL_DIR=/var/tmp/models/Qwen3.8-Flash-Next-NVFP4-nvidia-fp8hybrid
#VERIFIED_MARKER=.verified
#CACHE_DIR=/var/tmp/qwen38fn-vllm-cache

# The ten Cortex-X925 cores of the GB10 (CPU part 0xd85). The A725 cores are 0-4,10-14.
#CPUSET=5-9,15-19

# Where the overlays and the built files live. The defaults point into this repository.
#PATCHES=<repo>/patches
#BUILD=<repo>/build
#PLE_OVERLAY=$PATCHES/ple-checkpoint-mapped/vllm-overlay
#FP8_HYBRID=$PATCHES/fp8-hybrid
#CACHE_DET=$PATCHES/cache-det
#DET_LIB=$BUILD/_C_det.so
#DRAFT_HEAD=$PATCHES/draft-nvfp4-head
#DRAFT_VOCAB=$BUILD/draft_vocab_public_65536.npy
#DRAFT_VOCAB_DIR=/opt/draft-vocab
#TOOL_PARSER=$PATCHES/tool-parser
